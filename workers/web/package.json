    "@vitejs/plugin-react": "latest",
    "cf": "latest",
    "vite": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0"

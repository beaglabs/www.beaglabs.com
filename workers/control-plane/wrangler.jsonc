{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beaglabs-papyrus-control-plane",
  "main": "src/entry.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "papyrus.beaglabs.com", "custom_domain": true }],
  "observability": { "enabled": true },
  // Accounts, sessions, deployments, encrypted provider credentials, setup progress.
  // Create once: wrangler d1 create papyrus-control-plane, then paste the id here.
  "d1_databases": [
    { "binding": "DB", "database_name": "papyrus-control-plane", "database_id": "d92c7f96-60a2-41e0-bd4b-373510d14ac1" }
  ],
  // Deployment rows, deployment keys and the Key Vault signer stay in the license Worker.
  "services": [{ "binding": "LICENSE", "service": "beaglabs-license", "entrypoint": "LicenseRpc" }],
  "vars": {
    "BASE_URL": "https://papyrus.beaglabs.com",
    "CHAT_API_ORIGIN": "https://license.beaglabs.com",
    "PAPYRUS_IMAGE": "ghcr.io/beaglabs/papyrus/papyrus",
    "PAPYRUS_IMAGE_DIGEST": "sha256:0fed2e391690581847e96192c7c4d6aca1754807c7c0f9c2bc27046bc3f9ac5c",
    "MAGIC_LINK_FROM_EMAIL": "Papyrus <papyrus@mail.beaglabs.com>",
    // Beag Labs' IAM principal that customer roles trust, and the S3 copy of /aws/connect-template.yaml.
    "AWS_PRINCIPAL_ARN": "arn:aws:iam::615583899145:user/papyrus-control-plane",
    "AWS_CONNECT_TEMPLATE_URL": "https://beaglabs-public.s3.us-east-2.amazonaws.com/connect-aws.yaml",
    // Bring-your-own-cloud is off: "true" turns it on for every account (else per account in D1 account_flags).
    "BYOC_ENABLED": "false",
    // Hosted by Beag Labs: the Connect AWS stack deployed once into Beag Labs' own account (README → Hosted setup).
    "HOSTED_AWS_ROLE_ARN": "arn:aws:iam::615583899145:role/BeagLabsPapyrusControlPlane",
    "HOSTED_AWS_REGION": "us-east-2"
  },
  "secrets": {
    "required": [
      "CREDENTIALS_KEY",
      "SESSION_SECRET",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "MICROSOFT_CLIENT_ID",
      "MICROSOFT_CLIENT_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "RESEND_API_KEY",
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "HOSTED_AWS_EXTERNAL_ID",
      "ADMIN_TOKEN"
    ]
  }
}

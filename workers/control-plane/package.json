{
  "name": "@beaglabs/control-plane-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run --config wrangler.jsonc --outdir .wrangler-dry-run",
    "db:apply": "wrangler d1 execute papyrus-control-plane --remote --file schema.sql --config wrangler.jsonc",
    "deploy": "npm run db:apply && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@distilled.cloud/aws": "1.0.0-rc.15",
    "@distilled.cloud/azure": "1.0.0-rc.15",
    "@distilled.cloud/cloudflare": "1.0.0-rc.15",
    "@distilled.cloud/coolify": "1.0.0-rc.15",
    "@distilled.cloud/core": "1.0.0-rc.15",
    "@distilled.cloud/daytona": "1.0.0-rc.15",
    "@distilled.cloud/digitalocean": "1.0.0-rc.15",
    "@distilled.cloud/docker": "1.0.0-rc.15",
    "@distilled.cloud/fly-io": "1.0.0-rc.15",
    "@distilled.cloud/gcp": "1.0.0-rc.15",
    "@distilled.cloud/hetzner": "1.0.0-rc.15",
    "@distilled.cloud/hostinger": "1.0.0-rc.15",
    "@distilled.cloud/kubernetes": "1.0.0-rc.15",
    "@distilled.cloud/ovh": "1.0.0-rc.15",
    "@distilled.cloud/railway": "1.0.0-rc.15",
    "@distilled.cloud/render": "1.0.0-rc.15",
    "@distilled.cloud/stackit": "1.0.0-rc.15",
    "@distilled.cloud/stripe": "1.0.0-rc.15",
    "effect": "4.0.5",
    "hono": "4.13.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.147.0"
  }
}

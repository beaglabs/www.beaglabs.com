{
  // The browser bundle (src/client) and the components it shares with server rendering (src/ui), checked against
  // the real DOM lib. The Worker's tsconfig.json checks src/ui loosely (types/server-dom.d.ts).
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src/client/**/*.tsx", "src/ui/**/*.ts", "src/ui/**/*.tsx"]
}

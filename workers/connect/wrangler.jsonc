{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beaglabs-connect",
  "main": "src/entry.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "connect.beaglabs.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "AZURE_KEY_VAULT_URL": "https://stripe-connect.vault.azure.net"
  },
  "secrets": {
    "required": [
      "TURSO_DATABASE_URL",
      "TURSO_AUTH_TOKEN",
      "AZURE_KEY_VAULT_TENANT_ID",
      "AZURE_KEY_VAULT_CLIENT_ID",
      "AZURE_KEY_VAULT_CLIENT_SECRET",
      "LICENSE_AUTHORITIES"
    ]
  }
}

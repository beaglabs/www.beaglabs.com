  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.5",
    "@libsql/client": "^0.17.4",
    "better-auth": "^1.7.5",
    "hono": "^4.12.31",
    "kysely": "^0.29.0",
    "kysely-libsql": "^0.7.1",
    "resend": "^6.17.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.129.0"
  }
}

{
  "name": "@beaglabs/license-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run db:apply && npm run deploy:worker",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "db:apply": "node --env-file-if-exists=.dev.vars scripts/apply-schema.mjs",
    "deploy:worker": "wrangler deploy --config wrangler.jsonc",
    "license:issue": "node --env-file-if-exists=.dev.vars scripts/issue-license.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "hono": "^4.12.31",
    "resend": "^6.17.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.147.0"
  }
}

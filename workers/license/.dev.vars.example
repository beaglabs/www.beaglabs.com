# Copy to .dev.vars for local development only. Never commit real values.
TURSO_DATABASE_URL="libsql://YOUR-DATABASE.turso.io"
TURSO_AUTH_TOKEN=""
BETTER_AUTH_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
# Comma-separated Microsoft Entra object IDs (oid), not email addresses.
ADMIN_MICROSOFT_OIDS=""

# Production license signing uses a version-pinned Azure Key Vault key.
# Use a dedicated service principal that can sign with this key and nothing else.
AZURE_KEY_VAULT_TENANT_ID=""
AZURE_KEY_VAULT_CLIENT_ID=""
AZURE_KEY_VAULT_CLIENT_SECRET=""
# Full VERSIONED key URI, e.g. https://beag-license.vault.azure.net/keys/papyrus-license/<version>
AZURE_KEY_VAULT_KEY_ID=""

# Resend API key used for Marketplace lead threads and legacy partner email flows.
RESEND_API_KEY=""

# Logic Apps / Power Automate forwards Microsoft Marketplace leads here using:
# X-Beag-Timestamp + X-Beag-Signature = HMAC-SHA256(secret, `${timestamp}.${rawBody}`)
MARKETPLACE_LEAD_WEBHOOK_SECRET=""

# Optional dedicated Partner Center analytics app credentials. If omitted, the Worker
# falls back to MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET / MICROSOFT_TENANT_ID.
MARKETPLACE_ANALYTICS_TENANT_ID=""
MARKETPLACE_ANALYTICS_CLIENT_ID=""
MARKETPLACE_ANALYTICS_CLIENT_SECRET=""

# These are non-secret production vars in wrangler.jsonc; override locally if useful.
BASE_URL="http://localhost:8787"
PARTNERS_EMAIL="partnerships@beaglabs.com"
PARTNER_FROM_EMAIL="Beag Labs Partners <partners@mail.beaglabs.com>"
MARKETPLACE_FROM_EMAIL="Beag Labs Marketplace <sales@mail.beaglabs.com>"
LOGO_DEV_TOKEN="pk_PJhuwvcfSPKKCJJxJcElsQ"


# Customer provisioning portal. Commercial can fall back to MICROSOFT_CLIENT_ID /
# MICROSOFT_CLIENT_SECRET if that app registration is configured as multitenant.
PROVISION_COMMERCIAL_CLIENT_ID=""
PROVISION_COMMERCIAL_CLIENT_SECRET=""

# Azure Government is a separate national cloud and requires a separate app registration.
PROVISION_GOVERNMENT_CLIENT_ID=""
PROVISION_GOVERNMENT_CLIENT_SECRET=""

# Papyrus Marketplace software rate used for portal estimates only. Microsoft
# Marketplace remains the billing system of record.
PAPYRUS_VCPU_HOURLY_USD="0.50"

# Copy to .dev.vars for local development only. Never commit real values.
TURSO_DATABASE_URL="libsql://YOUR-DATABASE.turso.io"
TURSO_AUTH_TOKEN=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# Offline license signing (npm run license:issue) uses a version-pinned Azure Key Vault key.
# Use a dedicated service principal that can sign with this key and nothing else.
AZURE_KEY_VAULT_TENANT_ID=""
AZURE_KEY_VAULT_CLIENT_ID=""
AZURE_KEY_VAULT_CLIENT_SECRET=""
# Full VERSIONED key URI, e.g. https://beag-license.vault.azure.net/keys/papyrus-license/<version>
AZURE_KEY_VAULT_KEY_ID=""

# Resend API key used for Marketplace lead threads and usage-sync alerts.
RESEND_API_KEY=""

# Signed Teams workflow webhook for homepage trial-click notifications.
# Set in production using Wrangler secret put; never expose in browser code.
TRIAL_NOTIFICATIONS_WEBHOOK_URL=""

# Logic Apps / Power Automate forwards Microsoft Marketplace leads here using:
# X-Beag-Timestamp + X-Beag-Signature = HMAC-SHA256(secret, `${timestamp}.${rawBody}`)
MARKETPLACE_LEAD_WEBHOOK_SECRET=""

# Optional dedicated Partner Center analytics app credentials. If omitted, the Worker
# falls back to MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET / MICROSOFT_TENANT_ID.
MARKETPLACE_ANALYTICS_TENANT_ID=""
MARKETPLACE_ANALYTICS_CLIENT_ID=""
MARKETPLACE_ANALYTICS_CLIENT_SECRET=""

# These are non-secret production vars in wrangler.jsonc; override locally if useful.
BASE_URL="http://localhost:8787"
MARKETPLACE_FROM_EMAIL="Beag Labs Marketplace <sales@mail.beaglabs.com>"

# --- Papyrus admin app, customer chat, event pipe -------------------------------
# Admin app API app registration (staff tokens). Production value is in wrangler.jsonc.
ADMIN_API_CLIENT_ID="76fd8c28-6c8d-4b41-ae10-a99da42880a1"
# HMAC secret for 1-hour customer chat session JWTs. Generate: openssl rand -base64 48
CHAT_SESSION_SECRET=""
# Optional Marketplace plan pin for /api/provision/bootstrap (unset = plan check skipped).
PAPYRUS_MARKETPLACE_PUBLISHER=""
PAPYRUS_MARKETPLACE_PRODUCT=""
# Customer.io Track API (forwarding skipped when unset). CUSTOMERIO_REGION = us | eu.
CUSTOMERIO_SITE_ID=""
CUSTOMERIO_API_KEY=""
CUSTOMERIO_REGION="us"
# Cloudflare RealtimeKit (huddles). API token needs the Realtime / Realtime Admin permission.
CF_ACCOUNT_ID=""
REALTIMEKIT_APP_ID=""
REALTIMEKIT_API_TOKEN=""
REALTIMEKIT_PRESET_NAME="group_call_participant"
# Sentry internal integration client secret (verifies Sentry-Hook-Signature).
SENTRY_CLIENT_SECRET=""
# Push: FCM HTTP v1 (Android). FCM_SERVICE_ACCOUNT_JSON is the full service-account JSON key.
FCM_PROJECT_ID=""
FCM_SERVICE_ACCOUNT_JSON=""
# Push: APNs token auth (macOS). APNS_PRIVATE_KEY is the .p8 PEM contents. APNS_ENVIRONMENT = production | sandbox.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="com.beaglabs.papyrus.admin"
APNS_PRIVATE_KEY=""
APNS_ENVIRONMENT="production"

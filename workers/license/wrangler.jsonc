{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beaglabs-license",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "license.beaglabs.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BASE_URL": "https://license.beaglabs.com"
  },
  "secrets": {
    "required": [
      "TURSO_DATABASE_URL",
      "TURSO_AUTH_TOKEN",
      "BETTER_AUTH_SECRET",
      "MICROSOFT_CLIENT_ID",
      "MICROSOFT_CLIENT_SECRET",
      "MICROSOFT_TENANT_ID",
      "ADMIN_MICROSOFT_OIDS",
      "PAPYRUS_LICENSE_KEY_ID",
      "PAPYRUS_LICENSE_PRIVATE_KEY_PEM"
    ]
  }
}

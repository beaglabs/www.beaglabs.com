{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beaglabs-license",
  "main": "src/entry.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "license.beaglabs.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BASE_URL": "https://license.beaglabs.com",
    "PARTNERS_EMAIL": "partners@beaglabs.com",
    "PARTNER_FROM_EMAIL": "Beag Labs Partners <partners@mail.beaglabs.com>",
    "LOGO_DEV_TOKEN": "pk_PJhuwvcfSPKKCJJxJcElsQ"
  },
  "secrets": {
    "required": [
      "TURSO_DATABASE_URL",
      "TURSO_AUTH_TOKEN",
      "BETTER_AUTH_SECRET",
      "MICROSOFT_CLIENT_ID",
      "MICROSOFT_CLIENT_SECRET",
      "MICROSOFT_TENANT_ID",
      "ADMIN_MICROSOFT_OIDS",
      "AZURE_KEY_VAULT_TENANT_ID",
      "AZURE_KEY_VAULT_CLIENT_ID",
      "AZURE_KEY_VAULT_CLIENT_SECRET",
      "AZURE_KEY_VAULT_KEY_ID",
      "RESEND_API_KEY"
    ]
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beaglabs-license",
  "main": "src/entry.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "license.beaglabs.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "observability": {
    "enabled": true
  },
  // Chat was removed on 2026-10-17 (support is email now). The ConversationRoom Durable Object
  // class is deleted by v2; keep both tags so already-deployed environments migrate cleanly.
  "migrations": [
    { "tag": "v1-conversation-room", "new_sqlite_classes": ["ConversationRoom"] },
    { "tag": "v2-remove-conversation-room", "deleted_classes": ["ConversationRoom"] }
  ],
  "vars": {
    "BASE_URL": "https://license.beaglabs.com",
    "MARKETPLACE_FROM_EMAIL": "Beag Labs Marketplace <sales@mail.beaglabs.com>",
    "TRIAL_NOTIFICATIONS_EMAIL": "4661da0e.beaglabs.onmicrosoft.com@amer.teams.ms"
  },
  "secrets": {
    "required": [
      "TURSO_DATABASE_URL",
      "TURSO_AUTH_TOKEN",
      "MICROSOFT_CLIENT_ID",
      "MICROSOFT_CLIENT_SECRET",
      "MICROSOFT_TENANT_ID",
      "RESEND_API_KEY",
      "MARKETPLACE_LEAD_WEBHOOK_SECRET"
    ]
  }
}

# Copy to .env.local and fill in real values. Do not commit .env.local.

# --- Better Auth (lib/auth-server.ts) ---
# Required in every real environment. Generate one with: openssl rand -base64 32
# Without it, Better Auth falls back to an insecure default and logs a warning.
BETTER_AUTH_SECRET=

# Public origin Better Auth uses for callbacks/redirects. Falls back to
# NEXT_PUBLIC_APP_URL, then to a per-environment default, when unset.
BETTER_AUTH_URL=http://localhost:3000

# Postgres connection for the Better Auth database (DATABASE_AUTH_URL wins).
DATABASE_AUTH_URL=
DATABASE_URL=

# OAuth social providers (optional; leave blank to disable a provider).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App origin used for trustedOrigins and as a BETTER_AUTH_URL fallback.
NEXT_PUBLIC_APP_URL=http://localhost:3000
